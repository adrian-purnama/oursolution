# Copy to admin.env.local (git-ignored) and fill in.
# The backend to create products in, e.g. http://localhost:8000 or the production API.
FEDIER_API_URL=http://localhost:8000
# An admin's session token: sign in to the site as an admin, open DevTools →
# Application → Local Storage → `auth_token`, and paste its value here.
FEDIER_ADMIN_JWT=
