PORT=8000
# Also the database name. "development" or "development-<name>" (e.g. development-fedier)
# counts as development: debug logs on, short JWT_SECRET tolerated.
BUILD=development-fedier
MONGODB_URL=mongodb://localhost:27017
FRONTEND_URL=http://localhost:3000
# This API's public URL, e.g. https://api.example.com. Midtrans is told to send
# payment notifications to BACKEND_URL/payments/midtrans/notification. Left as
# localhost in development, where Midtrans cannot reach us (payments are polled).
BACKEND_URL=http://localhost:8000
# The site users open. Links in notification emails are APP_BASE_URL + a
# relative path such as /support/123. Optional: defaults to FRONTEND_URL.
APP_BASE_URL=http://localhost:3000

# Mail over SMTP. SMTP_SECURE=true for port 465 (TLS), false for 587 (STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Signs the short-lived links to private support-ticket photos. 32+
# characters; required outside development. e.g. openssl rand -hex 32
MEDIA_SIGNING_SECRET=

# Dokploy, where subscriptions are deployed. Optional: leave empty to run
# without deployments. Create the key in Dokploy under Settings > Profile > API/CLI.
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=

# Deployed hosts are "<subdomain>.<DEPLOY_DOMAIN>". It must be a zone in the
# Cloudflare account below.
DEPLOY_DOMAIN=example.com
# Cloudflare tunnel that routes those hosts to Dokploy. CLOUDFLARE_TUNNEL_ID is
# the tunnel's ID (a UUID, shown on the tunnel's page), not its token. The token needs
# Account > Cloudflare Tunnel > Edit and Zone > DNS > Edit (plus Zone > Read).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_ID=
# Where the tunnel sends traffic. Default: http://dokploy-traefik:80
CLOUDFLARE_TUNNEL_SERVICE=

# Folders on the Dokploy host that hold customers' data, comma-separated;
# * stands for part of one folder name. "Reset" empties a customer's own
# folder only when it is inside one of these. Leave empty to turn reset off.
DEPLOY_DATA_ROOTS=/mnt/nas-sd*

# Uptime Kuma, which checks that deployed services answer and feeds the
# status shown in the dashboard. Optional. Kuma's API keys only read /metrics,
# so this is a Kuma account (without two-factor sign-in): make one for the app.
UPTIME_KUMA_URL=https://kuma.example.com
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=

# DeepSeek writes the AI summary when an admin closes a ticket; the ticket's
# messages are sent to it. Create a key at https://platform.deepseek.com.
# Optional: leave the key empty and tickets close without a summary.
DEEPSEEK_API_KEY=
# Defaults to https://api.deepseek.com and deepseek-chat. Any OpenAI-compatible
# API works: base URL only, /v1/chat/completions is appended.
LLM_BASE_URL=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=512

# Midtrans takes payments (Snap). MIDTRANS_URL is https://app.sandbox.midtrans.com
# for testing or https://app.midtrans.com for real money. Without a server key,
# development approves checkouts without charging and other builds refuse them.
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_URL=https://app.sandbox.midtrans.com
# Optional: overrides the notification URL made from BACKEND_URL. Sent with each
# transaction so Midtrans notifies this app; pending payments are also polled.
MIDTRANS_NOTIFICATION_URL=
# Minutes an unpaid invoice can still be paid. Default 60.
PAYMENT_TTL_MINUTES=60
