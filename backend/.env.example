PORT=8000
# Also the database name. "development" or "development-<name>" (e.g. development-fedier)
# counts as development: debug logs on, short JWT_SECRET tolerated.
BUILD=development-fedier
MONGODB_URL=mongodb://localhost:27017
FRONTEND_URL=http://localhost:3000

BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
