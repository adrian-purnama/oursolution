{
  "deployment": {
    "name": "documenso-${USERNAME}",
    "variables": [
      { "key": "TIMEZONE", "value": "Asia/Jakarta", "visibility": "editable" },
      { "key": "DISABLE_SIGNUP", "value": "false", "visibility": "editable" },
      { "key": "SMTP_HOST", "value": "smtp.gmail.com", "visibility": "editable" },
      { "key": "SMTP_PORT", "value": "465", "visibility": "editable" },
      { "key": "SMTP_SECURE", "value": "true", "visibility": "editable" },
      { "key": "SMTP_USERNAME", "value": "${EMAIL}", "visibility": "editable" },
      { "key": "SMTP_PASSWORD", "value": "", "visibility": "editable" },
      { "key": "SMTP_FROM", "value": "${EMAIL}", "visibility": "editable" },
      { "key": "SMTP_FROM_NAME", "value": "Documenso", "visibility": "editable" }
    ],
    "domains": [{ "serviceName": "documenso", "subdomain": "docs-${USERNAME}", "port": 3000 }]
  }
}
